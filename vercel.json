{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/api/hello-world/mcp$",
      "dest": "/api/hello-world/mcp.js"
    },
    {
      "src": "^/api/hello-world/hello-world$",
      "dest": "/api/hello-world/hello-world.js"
    }
  ]
}
